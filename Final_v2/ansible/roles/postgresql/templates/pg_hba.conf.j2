# PostgreSQL Client Authentication Configuration
# Generated by Ansible

# TYPE  DATABASE        USER            ADDRESS                 METHOD
local   all             postgres                                peer
local   all             all                                     peer
host    all             all             127.0.0.1/32            scram-sha-256

# Backend (on same host) - speedtest DB
host    {{ pg_speedtest_db }}  {{ pg_speedtest_user }}  {{ backend_db_ip }}/32    scram-sha-256

# Frontend backend - speedtest DB
host    {{ pg_speedtest_db }}  {{ pg_speedtest_user }}  {{ frontend_ip }}/32      scram-sha-256

# Monitoring - grafana DB
host    {{ pg_grafana_db }}    {{ pg_grafana_user }}    {{ monitoring_ip }}/32    scram-sha-256

# Replication - db-replica (standby)
host    replication     {{ pg_replicator_user }}  {{ db_replica_ip }}/32          scram-sha-256

# IPv6
host    all             all             ::1/128                 scram-sha-256
