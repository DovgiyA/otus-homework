global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - '{{ private_ip }}:9093'

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: 'prometheus'
    basic_auth:
      username: '{{ prometheus_basic_auth_user }}'
      password: '{{ prometheus_basic_auth_password }}'
    static_configs:
      - targets: ['{{ private_ip }}:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
          - '{{ frontend_ip }}:9100'
        labels:
          hostname: 'frontend'
{% if backend_db_active | default(true) %}
      - targets:
          - '{{ backend_db_ip }}:9100'
        labels:
          hostname: 'backend-db'
{% endif %}
      - targets:
          - '{{ db_replica_ip }}:9100'
        labels:
          hostname: 'db-replica'
      - targets:
          - '{{ backup_ip }}:9100'
        labels:
          hostname: 'backup'
      - targets:
          - '{{ monitoring_ip }}:9100'
        labels:
          hostname: 'monitor'

  - job_name: 'blackbox_http'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - 'https://{{ domain_name }}/'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 'localhost:9115'

  - job_name: 'blackbox_tcp_db'
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
      - targets:
          - '{{ (not (backend_db_active | default(true))) | ternary(db_replica_ip, backend_db_ip) }}:5432'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 'localhost:9115'
