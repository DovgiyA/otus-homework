---
# Template for sensitive data. 
# Copy this file to secrets.yml and encrypt it using:
# ansible-vault encrypt ansible/inventory/group_vars/secrets.yml

# PostgreSQL
pg_speedtest_password: "CHANGEME_SECURE_PASSWORD"
pg_grafana_password: "CHANGEME_SECURE_PASSWORD"
pg_replicator_password: "CHANGEME_SECURE_PASSWORD"
pg_postgres_password: "CHANGEME_SECURE_PASSWORD"

# Prometheus / Grafana
prometheus_basic_auth_password: "CHANGEME_PROMETHEUS_PASSWORD"
grafana_admin_password: "CHANGEME_GRAFANA_ADMIN_PASSWORD"

# Telegram
telegram_bot_token: "CHANGEME_TELEGRAM_TOKEN"
telegram_chat_id: 1247569610 # This is usually not a secret but can be here

# LibreSpeed
librespeed_stats_password: "CHANGEME_LIBRESPEED_STATS_PASSWORD"
librespeed_obfuscation_salt: "CHANGEME_RANDOM_SALT"
