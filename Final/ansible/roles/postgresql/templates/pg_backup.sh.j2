#!/bin/bash
# PostgreSQL Backup Script
# Generated by Ansible

BACKUP_DIR="/var/backups/postgresql"
DATE=$(date +%Y-%m-%d_%H%M%S)
RETENTION_DAYS=7

echo "=== PostgreSQL Backup Started at $(date) ==="

# Backup speedtest database
pg_dump -U postgres {{ pg_speedtest_db }} | gzip > "${BACKUP_DIR}/{{ pg_speedtest_db }}_${DATE}.sql.gz"
echo "Backed up {{ pg_speedtest_db }}"

# Backup grafana database
pg_dump -U postgres {{ pg_grafana_db }} | gzip > "${BACKUP_DIR}/{{ pg_grafana_db }}_${DATE}.sql.gz"
echo "Backed up {{ pg_grafana_db }}"

# Full cluster backup with pg_basebackup
pg_basebackup -D "${BACKUP_DIR}/base_backup_${DATE}" -Ft -z -P 2>/dev/null
if [ $? -eq 0 ]; then
    echo "Base backup completed"
else
    echo "Base backup failed (may be running already)"
fi

# Remove old backups
find "${BACKUP_DIR}" -name "*.sql.gz" -mtime +${RETENTION_DAYS} -delete
find "${BACKUP_DIR}" -name "base_backup_*" -type d -mtime +${RETENTION_DAYS} -exec rm -rf {} + 2>/dev/null

echo "Cleaned up backups older than ${RETENTION_DAYS} days"
echo "=== PostgreSQL Backup Finished at $(date) ==="
