# Grafana Configuration
# Generated by Ansible

[server]
http_addr = 0.0.0.0
http_port = 3000
domain = {{ monitoring_ip }}
root_url = http://{{ monitoring_ip }}:3000/

[database]
type = postgres
host = {{ db_primary_ip }}:5432
name = {{ pg_grafana_db }}
user = {{ pg_grafana_user }}
password = {{ pg_grafana_password }}
ssl_mode = disable

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
secret_key = SW2YcwTIb9zpOOhoPsMm

[users]
allow_sign_up = false
auto_assign_org = true
auto_assign_org_role = Viewer

[auth.anonymous]
enabled = false

[log]
mode = file
level = info

[log.file]
log_rotate = true
max_lines = 1000000
max_size_shift = 28
daily_rotate = true
max_days = {{ log_retention_days }}

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/node_exporter.json

[alerting]
enabled = false

[unified_alerting]
enabled = true
