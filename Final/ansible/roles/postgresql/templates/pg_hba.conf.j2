# PostgreSQL Client Authentication Configuration File
# Generated by Ansible

# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections
local   all             postgres                                peer
local   all             all                                     peer

# IPv4 local connections
host    all             all             127.0.0.1/32            scram-sha-256

# Backend servers - speedtest DB access
host    {{ pg_speedtest_db }}  {{ pg_speedtest_user }}  {{ backend1_ip }}/32    scram-sha-256
host    {{ pg_speedtest_db }}  {{ pg_speedtest_user }}  {{ backend2_ip }}/32    scram-sha-256

# Monitoring server - grafana DB access
host    {{ pg_grafana_db }}    {{ pg_grafana_user }}    {{ monitoring_ip }}/32  scram-sha-256

# Replication connections
host    replication     {{ pg_replicator_user }}  {{ db_replica_ip }}/32       scram-sha-256

# IPv6 local connections
host    all             all             ::1/128                 scram-sha-256
