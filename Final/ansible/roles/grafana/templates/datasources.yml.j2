# Grafana Datasources Provisioning
# Generated by Ansible

apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    basicAuth: true
    basicAuthUser: {{ prometheus_basic_auth_user }}
    secureJsonData:
      basicAuthPassword: {{ prometheus_basic_auth_password }}
    isDefault: true
    editable: true

  - name: Elasticsearch
    type: elasticsearch
    access: proxy
    url: http://localhost:9200
    database: "fluentd-*"
    jsonData:
      timeField: "@timestamp"
      esVersion: "8.0.0"
      maxConcurrentShardRequests: 5
      logMessageField: message
      logLevelField: log_level
    isDefault: false
    editable: true
