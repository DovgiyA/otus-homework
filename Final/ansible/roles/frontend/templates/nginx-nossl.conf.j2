# Nginx config WITHOUT SSL - Fallback
upstream speedtest_backends {
    ip_hash;
    server {{ backend1_ip }}:80;
    server {{ backend2_ip }}:80;
}

server {
    listen 80;
    server_name {{ domain_name }} {{ domain_name_www }};

    root /var/www/speedtest;
    index index.html;

    client_max_body_size 35M;

    location / {
        try_files $uri $uri/ @backends;
    }

    location /backend/ {
        proxy_pass http://speedtest_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /results/ {
        proxy_pass http://speedtest_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /adminer/ {
        proxy_pass http://speedtest_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location @backends {
        proxy_pass http://speedtest_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    access_log /var/log/nginx/speedtest_access.log;
    error_log /var/log/nginx/speedtest_error.log;
}
