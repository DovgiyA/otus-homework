{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Log Count per Server (Cron)",
      "type": "barchart",
      "datasource": "Elasticsearch",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "@log_name:system.cron.*",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "hostname.keyword",
              "id": "2",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "3",
              "settings": {
                "interval": "1h"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Requests per Domain (Load Balancer)",
      "type": "barchart",
      "datasource": "Elasticsearch",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "query": "@log_name:nginx.access.*",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "hostname.keyword",
              "id": "2",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "3",
              "settings": {
                "interval": "1h"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Total Logs per Server",
      "type": "piechart",
      "datasource": "Elasticsearch",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "query": "*",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "hostname.keyword",
              "id": "2",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "title": "Log Stream (All Servers)",
      "type": "logs",
      "datasource": "Elasticsearch",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "query": "*",
          "metrics": [
            {
              "type": "logs",
              "id": "1"
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Error Logs Count",
      "type": "stat",
      "datasource": "Elasticsearch",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "query": "@log_name:*.error.*",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "hostname.keyword",
              "id": "2",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["logs", "elk", "fluentd"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Logs Dashboard",
  "uid": "logs-dashboard"
}
